# Copy to .env.local for local dev. All values are optional — the app boots with
# none of them (SQLite cache + steamid64/URL-only profile lookup).

# Steam Web API key. Only needed for vanity-URL resolution; a steamid64 or full
# profile URL works without it.
STEAM_API_KEY=

# Persistent cache backend. Unset -> on-disk SQLite (loader.db), which resets on
# hosts with an ephemeral filesystem (e.g. Render's free tier). Set to a Supabase
# *Session pooler* URI (port 5432 on *.pooler.supabase.com — the IPv4-compatible
# host; the direct db.*.supabase.co host is IPv6-only and many PaaS hosts have no
# IPv6 egress) to persist the inventory cache across restarts/deploys.
# Supabase dashboard: Project → Connect → Session pooler.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Set to "disable" to connect to a local plaintext Postgres without TLS. Leave
# unset for Supabase (TLS required).
# DATABASE_SSL=disable

# Optional: max Postgres pool connections (default 3). Keep small on the Supabase
# free tier / behind the pooler.
# PGPOOL_MAX=3
